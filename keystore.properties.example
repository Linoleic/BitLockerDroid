# ==============================================================================
# BitLockerDroid Release Signing Configuration Template
#
# Usage:
# 1. Copy this file to "keystore.properties":
#    cp keystore.properties.example keystore.properties
# 2. Fill in your own keystore file path and credentials below.
# 3. DO NOT commit "keystore.properties" or any "*.jks" / "*.keystore" to git.
#
# If "keystore.properties" does not exist or the keystore file is not found,
# Gradle will automatically fall back to the default Android debug keystore.
# ==============================================================================

# Path to the keystore file (absolute path or relative to project root or app/)
STORE_FILE=release.jks

# Keystore password
STORE_PASSWORD=your_store_password

# Key alias name
KEY_ALIAS=your_key_alias

# Key alias password
KEY_PASSWORD=your_key_password
