<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".BitLockerApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:theme="@style/Theme.BitLockerDroid"
        tools:targetApi="33">

        <activity
            android:name=".ui.UnlockDialogActivity"
            android:label="@string/unlock_title"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BitLockerDroid.Dialog"
            android:exported="true"
            tools:ignore="ExportedActivity">
            <intent-filter>
                <action android:name="com.bitlockerdroid.action.UNLOCK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BitLockerSettingsActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.BitLockerCoreService"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".provider.BitLockerDocumentsProvider"
            android:authorities="com.bitlockerdroid.provider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            tools:ignore="ExportedProvider">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Native library auto-loads via System.loadLibrary("dislocker") -->
    </application>
</manifest>
